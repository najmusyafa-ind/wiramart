# ==============================================================
# Smartkasir Perwira (Wiramart UNPERBA) — Environment Variables
# 
# PANDUAN PENGGUNAAN:
# 1. Lokal: Salin file ini menjadi .env.local (`cp .env.example .env.local`)
#    lalu isi nilai riil sesuai kredensial proyek Anda.
# 2. Vercel Production: Masukkan variabel-variabel di bawah ini ke
#    Vercel Dashboard → Project Settings → Environment Variables.
# 
# ⚠️ KEAMANAN: JANGAN PERNAH commit .env.local atau nilai secret ke git!
# ==============================================================

# --- SUPABASE PUBLIC (Client & Server) ---
# Dapatkan dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- DATABASE POSTGRESQL (Drizzle ORM) ---
# Dapatkan dari: Supabase Dashboard → Project Settings → Database → Connection string
# ⚠️ PENTING UNTUK VERCEL (Serverless):
# Gunakan "Transaction pooler" (port 6543) agar koneksi database tidak habis/exhausted.
# Format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# --- JWT SECRET (Autentikasi Sesi Karyawan & Admin) ---
# Generate secret acak (minimal 32 karakter) via terminal:
# openssl rand -base64 32
JWT_SECRET=generate-minimum-32-characters-random-secret-string

# --- SUPABASE SERVICE ROLE (Server-side Only) ---
# Digunakan untuk bypass RLS pada upload Storage (foto produk, QR QRIS) dari server route handler.
# Dapatkan dari: Supabase Dashboard → Project Settings → API → service_role key (secret)
# ⚠️ JANGAN tambahkan prefix NEXT_PUBLIC_ pada variabel ini!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- APP CONFIGURATION ---
NEXT_PUBLIC_APP_NAME=wiramart
# Lokal: http://localhost:3000
# Production Vercel: https://nama-project-anda.vercel.app (atau custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

