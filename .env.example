# ==============================================================
# Smartkasir Perwira — Environment Variables
# COPY file ini ke .env.local dan isi dengan nilai asli
# JANGAN commit .env.local ke git!
# ==============================================================

# --- SUPABASE (Wajib) ---
# Dapatkan dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- DATABASE (Drizzle ORM — koneksi langsung ke PostgreSQL) ---
# Dapatkan dari: Supabase Dashboard → Project Settings → Database → Connection string
# Gunakan "Transaction pooler" untuk serverless (Vercel)
DATABASE_URL=postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres

# --- JWT SECRET (untuk session token karyawan) ---
# Generate dengan: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# --- APP CONFIG ---
NEXT_PUBLIC_APP_NAME=Smartkasir Perwira
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- NODE ENV ---
# Otomatis di-set oleh Next.js: development | production | test
# NODE_ENV=development
