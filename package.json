    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "demo:cek": "tsx --env-file=.env.local scripts/cek-demo.ts",
    "demo:cek:staging": "tsx --env-file=.env.staging scripts/cek-demo.ts",
    "test": "tsx --env-file=.env.local --test --test-force-exit src/__tests__/production-invariants.test.ts",
    "test:staging": "tsx --env-file=.env.staging --test --test-force-exit src/__tests__/transaksi-tcl-and-invariants.test.ts"
  },
  "dependencies": {
