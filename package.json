  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "echo db:push DINONAKTIFKAN: drizzle-kit push --force dapat menimpa skema produksi. Gunakan migrasi SQL tertulis yang diuji di staging. && exit 1",
